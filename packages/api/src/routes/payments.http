# =============================================================================
# Madeirense API — /api/v1/payments
# Source: packages/api/src/routes/payments.ts
#
# Works with VS Code REST Client, kulala.nvim and JetBrains HTTP Client.
# Run the "login" request first: the token is read from its response.
# =============================================================================

@host = http://localhost:3001
@baseUrl = {{host}}/api/v1/payments
@apiKey = REPLACE_WITH_API_KEY
@email = admin@example.com
@password = REPLACE_WITH_PASSWORD
@token = {{login.response.body.$.tokens.sessionToken}}

### Log in (x-platform: mobile returns the tokens in the body instead of cookies)
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Create a payment
# payment_method: Credit_Card | Debit_Card | PayPal | Cash | Bank_Transfer |
#                 Payment_Reference | Multicaixa_Express | Offer
POST {{baseUrl}}
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

{
  "order_id": 1,
  "amount": 12500.00,
  "payment_method": "Multicaixa_Express"
}

### My payments
GET {{baseUrl}}/mine?page=1&limit=10
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

### Payment by id
GET {{baseUrl}}/1
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

### Update payment status (pending | completed | failed | refunded) — roles: Admin, Staff, Driver
PATCH {{baseUrl}}/1/status
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

{
  "status": "completed"
}

### All payments — roles: Admin
GET {{baseUrl}}?page=1&limit=10
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

### Delete a payment — roles: Admin
DELETE {{baseUrl}}/1
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}
