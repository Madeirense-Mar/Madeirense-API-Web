# =============================================================================
# Madeirense API — /api/v1/comments
# Source: packages/api/src/routes/comments.ts
#
# Works with VS Code REST Client, kulala.nvim and JetBrains HTTP Client.
# Run the "login" request first: the token is read from its response.
# =============================================================================

@host = http://localhost:3001
@baseUrl = {{host}}/api/v1/comments
@apiKey = REPLACE_WITH_API_KEY
@email = admin@example.com
@password = REPLACE_WITH_PASSWORD
@token = {{login.response.body.$.tokens.sessionToken}}

### Log in (x-platform: mobile returns the tokens in the body instead of cookies)
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### All comments (public)
GET {{baseUrl}}?page=1&limit=10
x-api-key: {{apiKey}}

### Comment by id (public)
GET {{baseUrl}}/1
x-api-key: {{apiKey}}

### Create a comment
POST {{baseUrl}}
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

{
  "product_id": 1,
  "comment": "Excelente prato, recomendo!"
}

### My comments
GET {{baseUrl}}/mine?page=1&limit=10
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

### Update my comment
PUT {{baseUrl}}/1
Content-Type: application/json
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

{
  "product_id": 1,
  "comment": "Comentário atualizado."
}

### Delete my comment
DELETE {{baseUrl}}/1
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}

### Delete any comment — roles: Admin
DELETE {{baseUrl}}/1/admin
x-api-key: {{apiKey}}
x-platform: mobile
Authorization: Bearer {{token}}
